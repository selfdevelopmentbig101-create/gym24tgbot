diff --git a/miniapp/src/lib/flash.ts b/miniapp/src/lib/flash.ts
new file mode 100644
index 0000000..5366104
--- /dev/null
+++ b/miniapp/src/lib/flash.ts
@@ -0,0 +1,10 @@
+/* A one-time message carried across a navigation (e.g. "Split chosen" shown on the Splits list). */
+let pending: string | null = null;
+
+export function setFlash(message: string): void { pending = message; }
+
+export function takeFlash(): string | null {
+  const message = pending;
+  pending = null;
+  return message;
+}
