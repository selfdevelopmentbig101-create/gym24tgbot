# Copy this file to .env and fill in your values. Never commit .env.

# Token from @BotFather (required)
BOT_TOKEN=9207875172:AAGbOQJAzW2itUFzv6E5K8htpznZaL8Avxg

# Database URL. SQLite for development; for PostgreSQL later use:
# postgresql+asyncpg://user:password@localhost:5432/gymbot
DATABASE_URL=sqlite+aiosqlite:///gymbot.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rate limit: at most RATE_LIMIT_MAX actions per RATE_LIMIT_WINDOW seconds per user
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW=5

# Exact credits text shown by /about (required by the RepDB image license)
EXERCISE_IMAGE_ATTRIBUTION=Exercise images from the RepDB dataset, used under its license.

# Comma-separated Telegram user IDs allowed to use /admin and /broadcast.
# Get yours from @userinfobot in Telegram.
ADMIN_IDS=5520003025

# Premium (paid in Telegram Stars; no payment provider needed).
# Set PREMIUM_ENABLED=false to make every feature free.
PREMIUM_ENABLED=true
PREMIUM_MONTH_STARS=150
PREMIUM_YEAR_STARS=1200

# Mini App address (must be HTTPS). With GitHub Pages it looks like:
# https://<github-username>.github.io/<repository>/webapp/
# Leave empty to hide the Mini App buttons.
WEBAPP_URL=https://cir-shopper-silver-charleston.trycloudflare.com           

# ----- Gym24 Mini App + API (see docs/LOCAL_HTTPS.md) -----
# Public HTTPS address of the Gym24 Mini App, e.g. your Cloudflare tunnel URL.
# When set, the bot makes it the chat menu button. Leave empty to disable.
MINIAPP_URL=https://cir-shopper-silver-charleston.trycloudflare.com                
# Mini App login data older than this many seconds is rejected (default 24 h).
INIT_DATA_MAX_AGE=86400
# API requests allowed per user per minute.
# Uvicorn - python -m uvicorn api.main:app --port 8000 --reload
# clouflare - cloudflared tunnel --url http://localhost:8000
# ./.venv/Scripts/Activate.ps1
API_RATE_LIMIT=120
