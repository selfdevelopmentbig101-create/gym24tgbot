# Copy this file to .env and fill in your values. Never commit .env.

# Token from @BotFather (required)
BOT_TOKEN=

# Database URL. SQLite for development; for PostgreSQL later use:
# postgresql+asyncpg://user:password@localhost:5432/gymbot
DATABASE_URL=sqlite+aiosqlite:///gymbot.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rate limit: at most RATE_LIMIT_MAX actions per RATE_LIMIT_WINDOW seconds per user
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW=5

# Exact credits text shown by /about (required by the RepDB image license)
EXERCISE_IMAGE_ATTRIBUTION=Exercise images from the RepDB dataset, used under its license.

# Comma-separated Telegram user IDs allowed to use /admin and /broadcast.
# Get yours from @userinfobot in Telegram.
ADMIN_IDS=
